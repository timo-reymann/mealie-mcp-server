{
  "name": "mealie-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Mealie recipe management",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:docs:check": "node scripts/gen-docs.mjs --check",
    "inspect": "npx @modelcontextprotocol/inspector dist/index.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "provenance": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timo-reymann/mealie-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "mealie",
    "recipe",
    "meal-planning"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@semantic-release/changelog": "^6",
    "@semantic-release/git": "^10",
    "@semantic-release/github": "^12",
    "@semantic-release/npm": "^13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "husky": "^9.1.7",
    "semantic-release": "^25",
    "tsx": "^4",
    "typescript": "~7.0.0",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "packageManager": "yarn@4.18.1+sha512.107f80e13c40b41597284d03190c56f41a3d72b5c72c9ef799fc634d026ebfc5e89cd5964e97a2f014392637331c9354f4644e4f27303059fc88ebd12195d470"
}
